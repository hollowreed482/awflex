#!/bin/sh
# Runs on a node at boot: tell awflex who I am and which branch to run on me.
# Settings come from /etc/awflex/callback.env:
#   AWFLEX_URL=https://awflex.example.com    (required)
#   AWFLEX_HOOK_TOKEN=...                    (if the server sets one)
#   AWFLEX_BRANCH=main                       (optional; server default otherwise)
#   AWFLEX_HOST=node001.cluster              (optional; hostname -f otherwise)
#   AWFLEX_CACERT=/etc/pki/internal-ca.pem   (optional; CA that signed the server's certificate)
#   AWFLEX_PLAYBOOK=other.yml                (only if the server permits nodes to choose)
# A kernel boot parameter wins, so a PXE entry can pin a node: awflex.branch=my-fix
set -eu
[ -r /etc/awflex/callback.env ] && . /etc/awflex/callback.env
: "${AWFLEX_URL:?set AWFLEX_URL in /etc/awflex/callback.env}"
BRANCH=${AWFLEX_BRANCH:-}
PLAYBOOK=${AWFLEX_PLAYBOOK:-}
for arg in $(cat /proc/cmdline 2>/dev/null); do
  case "$arg" in
    awflex.branch=*) BRANCH=${arg#awflex.branch=} ;;
    awflex.playbook=*) PLAYBOOK=${arg#awflex.playbook=} ;;
  esac
done
set -- --data-urlencode "host=${AWFLEX_HOST:-$(hostname -f)}"
[ -n "$BRANCH" ] && set -- "$@" --data-urlencode "branch=$BRANCH"
[ -n "$PLAYBOOK" ] && set -- "$@" --data-urlencode "playbook=$PLAYBOOK"
[ -n "${AWFLEX_HOOK_TOKEN:-}" ] && set -- "$@" -H "Authorization: Bearer $AWFLEX_HOOK_TOKEN"
[ -n "${AWFLEX_CACERT:-}" ] && set -- "$@" --cacert "$AWFLEX_CACERT"
# Retry for five minutes: awflex may be restarting, and the call is safe to repeat.
exec curl -fsS --retry 30 --retry-delay 10 --retry-all-errors --max-time 20 -X POST "$@" "$AWFLEX_URL/api/v1/hook"
