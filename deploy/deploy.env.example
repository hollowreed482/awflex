# Settings for deploy/deploy.sh. Copy this file into YOUR OWN repository (not
# this one), fill it in, and run:
#
#   deploy/deploy.sh --config /path/to/awflex-deploy.env
#   make deploy CONFIG=/path/to/awflex-deploy.env
#
# No secrets go in this file: only names and paths to files that hold them.

# Image name without a tag. Every build gets a new tag automatically.
IMAGE=registry.example.com/team/awflex

# The ansible image your playbooks already run in (collections, Python modules,
# CA certificates). Leave empty for the small default image with ansible-core.
BASE_IMAGE=registry.example.com/team/ansible-runner:1.0

# Kubernetes. The namespace must exist; the script creates none.
KUBE_CONTEXT=my-cluster
NAMESPACE=awflex

# Your copy of deploy/k8s/awflex.yaml (with AWFLEX_REPO, AWFLEX_INVENTORY and
# storage set), and any other manifests to apply with it.
MANIFEST=/path/to/my-site/awflex.yaml
EXTRA_MANIFESTS=/path/to/my-site/ingress.yaml

# Private registry: the pull secret is created once if it does not exist.
# Give either a user and a file holding the password or token, or an existing
# registry auth file. Leave PULL_SECRET empty for a public registry.
PULL_SECRET=registry-pull
REGISTRY_USER=svc-awflex
REGISTRY_PASSWORD_FILE=/path/to/registry-token
# REGISTRY_AUTH_FILE=/path/to/auth.json

# One node for doctor's real connection test after the deploy.
DOCTOR_HOST=node001

# Optional:
# BUILDER=container         # macOS default; podman or nerdctl on Linux
# PLATFORM=linux/amd64      # default: the cluster nodes' architecture
# BINARY=local              # local: cross-compile awflex here (needs Go); image: compile in the build
# GO_IMAGE=registry.example.com/mirror/golang:1.26-alpine   # for BINARY=image behind a mirror
# BUILD_ARGS="ANSIBLE_PACKAGES=ansible-core netaddr"       # default image only; separate several with ;
# SMOKE=0                   # skip the local test of the image
# REGISTRY_INSECURE=1       # registry without TLS (plain http)
# PUSH=0                    # keep the image local, for a cluster that uses this machine's images
# ROLLOUT_TIMEOUT=180s
